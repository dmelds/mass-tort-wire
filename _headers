# Security headers for every path. Netlify already sends
# Strict-Transport-Security at the edge, so it is not repeated here.
# SAMEORIGIN is safe for the home-screen app: it runs as its own window,
# not inside a frame.
# no-referrer: a click from the wire reaches the outside site with no referrer at all,
# so no publisher learns the wire's address or which firm's copy sent the reader.
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: no-referrer
  Permissions-Policy: camera=(), microphone=(), geolocation=()

# Function replies are per-device and must never be served from a cache.
/.netlify/functions/*
  Cache-Control: no-store
